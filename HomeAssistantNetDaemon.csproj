<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>12.0</LangVersion>
        <Nullable>enable</Nullable>
        <RootNamespace>HomeAssistantNetDaemon</RootNamespace>
    </PropertyGroup>
    
    <ItemGroup>
        <None Update="$(MSBuildProjectDir)appsettings.Development.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        </None>        
        <None Update="$(MSBuildProjectDir)appsettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="$(MSBuildProjectDir)**\*.yaml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
    </ItemGroup>
    <Target Name="AfterPublishMessage" AfterTargets="Publish">
        <Message Text="Publish done! Copy all content in directory: $(PublishDir) to the `/config/netdaemon3' folder for add-on or your custom folder to deplpoy" Importance="high" />
    </Target>
        
    <ItemGroup>
        <PackageReference Include="NetDaemon.AppModel" Version="26.29.2" />
        <PackageReference Include="NetDaemon.Extensions.Mqtt" Version="26.29.2" />
        <PackageReference Include="NetDaemon.Runtime" Version="26.29.2" />
        <PackageReference Include="NetDaemon.HassModel" Version="26.29.2" />
        <PackageReference Include="NetDaemon.Client" Version="26.29.2" />
        <PackageReference Include="NetDaemon.Extensions.Scheduling" Version="26.29.2" />
        <PackageReference Include="NetDaemon.Extensions.Logging" Version="26.29.2" />
        <PackageReference Include="NetDaemon.Extensions.Tts" Version="26.29.2" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
        <PackageReference Include="SSH.NET" Version="2025.1.0" />
        <PackageReference Include="System.Reactive" Version="7.0.0" />
        <PackageReference Include="Tmds.MDns" Version="0.9.0" />
    </ItemGroup>
        
    <ItemGroup>
      <Folder Include="apps\AppModel\" />
    </ItemGroup>
</Project>
